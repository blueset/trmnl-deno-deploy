{
  "name": "@blueset/trmnl-deno-deploy",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --unstable-kv src/index.ts",
    "start": "deno run --allow-net --allow-env --unstable-kv src/index.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/ tests/ scripts/",
    "test": "deno test --allow-env --allow-read --unstable-kv tests/",
    "test:integration": "DENO_SANDBOX_INTEGRATION=1 deno test --allow-all --unstable-kv tests/google-fonts/sandbox_integration_test.ts",
    "doctor": "deno run --allow-all scripts/sandbox-doctor.ts",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "imports": {
    "@deno/sandbox": "jsr:@deno/sandbox@^0.13.2",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing": "jsr:@std/testing@^1.0.18"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.ns", "deno.unstable", "dom", "esnext"]
  },
  "exclude": ["coverage/", ".deno/"]
}
