# Copy to `.env` and fill in. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Deno Sandbox
# ---------------------------------------------------------------------------
# Organization access token from https://console.deno.com -> Settings ->
# Organization Tokens. Required to create Deno Sandboxes.
# Use an organization token (ddo_...). A personal token (ddp_...) also works,
# but then DENO_DEPLOY_ORG must be set too.
DENO_DEPLOY_TOKEN=

# Organization slug. Only required when DENO_DEPLOY_TOKEN is a ddp_ token.
# DENO_DEPLOY_ORG=

# ---------------------------------------------------------------------------
# Service configuration (all optional; defaults shown)
# ---------------------------------------------------------------------------

# Upstream metadata document.
# GOOGLE_FONTS_METADATA_URL=https://blueset.github.io/google-fonts-metadata/metadata.json

# Minimum seconds between upstream conditional revalidations.
# METADATA_REVALIDATE_SECONDS=86400

# Sandbox hard wall-clock deadline for one evaluation, in milliseconds.
# SANDBOX_TIMEOUT_MS=20000

# Sandbox memory allocation (768-4096 MiB).
# SANDBOX_MEMORY_MB=768

# Maximum bytes accepted from sandbox stdout.
# SANDBOX_MAX_OUTPUT_BYTES=2097152

# Requests per minute per client IP.
# RATE_LIMIT_PER_MINUTE=30

# Maximum concurrent sandbox evaluations for this instance.
# SANDBOX_MAX_CONCURRENCY=2

# Set to "1" to enable the opt-in live sandbox integration test.
# DENO_SANDBOX_INTEGRATION=
